#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT

bun test
bun build "$ROOT/backend/customer-reviews.ts" --target=bun --outdir="$build_dir"
omarchy plugin validate "$ROOT"
jq -e '
  .id == "ryuhzk.customer-reviews"
  and .author == "ryuhzk"
  and .version == "0.1.0"
  and (.kinds | index("service")) != null
  and (.kinds | index("bar-widget")) != null
  and .entryPoints.service == "Service.qml"
  and .entryPoints.barWidget == "BarWidget.qml"
  and .barWidget.defaultSection == "center"
  and .barWidget.defaults.pollIntervalSec == 10800
' "$ROOT/manifest.json" >/dev/null

if rg -n '[一-龥]' "$ROOT/Service.qml" "$ROOT/BarWidget.qml" "$ROOT/Panel.qml" "$ROOT/manifest.json" "$ROOT/README.md"; then
  echo "User-visible plugin files must remain English-only" >&2
  exit 1
fi

if command -v qmllint >/dev/null 2>&1; then
  qmllint -I "${OMARCHY_PATH:-/usr/share/omarchy}/shell" \
    "$ROOT/Service.qml" "$ROOT/BarWidget.qml" "$ROOT/Panel.qml"
fi

echo "All checks passed."
